{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "types": ["node", "vite/client", "vitest"]
  },
  "include": [
    "src/types/**/*.ts",
    "src/utils/constants.ts",
    "src/vite-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
